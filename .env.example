# --- Database (Neon) ---
# DATABASE_URL = app_user role, POOLED host. The app connects as this
#   non-BYPASSRLS role so RLS is enforced. Password MUST equal APP_DB_PASSWORD
#   and be URL-safe (letters/digits only — no @ : / ? # % &).
DATABASE_URL=postgresql://app_user:pass@ep-xxx-pooler.REGION.aws.neon.tech/nsights?sslmode=require
# DATABASE_URL_UNPOOLED = Neon OWNER role, DIRECT host. Migrations + apply-rls only.
DATABASE_URL_UNPOOLED=postgresql://owner:pass@ep-xxx.REGION.aws.neon.tech/nsights?sslmode=require

# Required: password for the app_user login role. apply-rls promotes app_user
# to LOGIN with this password. The app connects as app_user so RLS is enforced
# (the Neon owner role bypasses RLS).
APP_DB_PASSWORD=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:8787

# --- App URLs ---
WEB_URL=http://localhost:5173
API_URL=http://localhost:8787

# --- Storage (Railway Volume path, local = ./var) ---
STORAGE_DIR=./var/storage

# --- Email (Postmark) — optional for MVP invites ---
POSTMARK_TOKEN=
EMAIL_FROM=no-reply@nsights.local

# Commentary = template-only in MVP. Vertex OUT of scope.
