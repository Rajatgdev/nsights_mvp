# --- Database (Neon, Frankfurt) ---
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nsights?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nsights?sslmode=require

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
BETTER_AUTH_URL=http://localhost:8787

# --- App URLs ---
WEB_URL=http://localhost:5173
API_URL=http://localhost:8787

# --- Storage (Railway Volume path, local = ./var) ---
STORAGE_DIR=./var/storage

# --- Email (Postmark) — optional for MVP invites ---
POSTMARK_TOKEN=
EMAIL_FROM=no-reply@nsights.local

# Commentary = template-only in MVP. Vertex OUT of scope.
